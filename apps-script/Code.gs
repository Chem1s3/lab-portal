const TABLES={users:['id','name','group','email','phone','telegram','spin','orcid','about','role','tag','shortName','active','updatedAt'],news:['id','title','text','date','createdBy'],conferences:['id','title','dates','url','comment','commentAuthor','image','recommended'],consultations:['id','date','time','endTime','booked','bookedBy','topic','comment'],folders:['id','studentId','name','isPublic'],works:['id','studentId','title','fileName','driveFileId','folderId','kind','status','checkedSV','checkedAD','returnedBy','corrections','date'],threads:['id','subject','recipients','createdBy','context'],messages:['id','threadId','authorId','body','files','createdAt'],notifications:['id','userId','text','date','read'],useful:['id','category','title','driveFileId','url','createdBy','createdAt'],audit_log:['id','actorId','action','entity','entityId','createdAt']};
function setup(){const p=PropertiesService.getScriptProperties();let ss=p.getProperty('SPREADSHEET_ID')?SpreadsheetApp.openById(p.getProperty('SPREADSHEET_ID')):SpreadsheetApp.create('Lab Portal — данные лаборатории');let folder=p.getProperty('DRIVE_FOLDER_ID')?DriveApp.getFolderById(p.getProperty('DRIVE_FOLDER_ID')):DriveApp.createFolder('Lab Portal — документы');Object.entries(TABLES).forEach(([n,h])=>{let s=ss.getSheetByName(n);if(!s)s=ss.insertSheet(n);if(!s.getLastRow()){s.getRange(1,1,1,h.length).setValues([h]).setFontWeight('bold');s.setFrozenRows(1);}});const f=ss.getSheetByName('Sheet1')||ss.getSheetByName('Лист1');if(f&&!TABLES[f.getName()]&&ss.getSheets().length>1)ss.deleteSheet(f);p.setProperties({SPREADSHEET_ID:ss.getId(),DRIVE_FOLDER_ID:folder.getId()});return{spreadsheetUrl:ss.getUrl(),driveUrl:folder.getUrl(),spreadsheetId:ss.getId(),driveFolderId:folder.getId()};}
function doGet(e){try{return out_({ok:true,data:route_((e&&e.parameter.action)||'status',e?e.parameter:{})});}catch(x){return out_({ok:false,error:String(x.message||x)});}}
function doPost(e){try{const q=JSON.parse(e.postData.contents||'{}');return out_({ok:true,data:route_(q.action,q.data||{})});}catch(x){return out_({ok:false,error:String(x.message||x)});}}
function route_(a,d){if(a==='status')return setup();if(a==='bootstrap')return bootstrap_();if(a==='replaceAll')return replaceAll_(d);if(a==='upload')return upload_(d);if(a==='download')return download_(d.fileId);throw new Error('Неизвестная операция');}
function bootstrap_(){const d={};Object.keys(TABLES).forEach(n=>d[n]=read_(n));d.storage=setup();return d;}
function replaceAll_(d){const l=LockService.getScriptLock();l.waitLock(30000);try{['users','news','conferences','consultations','folders','works','threads','messages','notifications'].forEach(n=>{if(Array.isArray(d[n]))write_(n,d[n]);});audit_(d.actorId||'anonymous','replaceAll','database','shared-state');return{savedAt:new Date().toISOString()};}finally{l.releaseLock();}}
function read_(n){const s=sheet_(n),v=s.getDataRange().getValues();if(v.length<2)return[];const h=v[0].map(String);return v.slice(1).filter(r=>r.some(x=>x!==''&&x!==null)).map(r=>Object.fromEntries(h.map((k,i)=>[k,decode_(r[i])])));}
function write_(n,rows){const s=sheet_(n),h=TABLES[n];s.clearContents();s.getRange(1,1,1,h.length).setValues([h]).setFontWeight('bold');s.setFrozenRows(1);if(rows.length)s.getRange(2,1,rows.length,h.length).setValues(rows.map(r=>h.map(k=>encode_(r[k]))));}
function upload_(d){if(!d.base64||!d.name)throw new Error('Файл не передан');const folder=DriveApp.getFolderById(setup().driveFolderId);const f=folder.createFile(Utilities.newBlob(Utilities.base64Decode(d.base64),d.mimeType||'application/octet-stream',d.name));audit_(d.actorId||'anonymous','upload','file',f.getId());return{fileId:f.getId(),name:f.getName(),url:f.getUrl(),size:f.getSize()};}
function download_(id){const f=DriveApp.getFileById(id),b=f.getBlob();return{name:f.getName(),mimeType:b.getContentType(),base64:Utilities.base64Encode(b.getBytes())};}
function audit_(actor,action,entity,id){const s=sheet_('audit_log'),r={id:Utilities.getUuid(),actorId:actor,action,entity,entityId:id,createdAt:new Date().toISOString()};s.appendRow(TABLES.audit_log.map(k=>r[k]||''));}
function sheet_(n){if(!TABLES[n])throw new Error('Недопустимый лист');return SpreadsheetApp.openById(setup().spreadsheetId).getSheetByName(n);}
function encode_(v){if(v===undefined||v===null)return'';return typeof v==='object'?JSON.stringify(v):v;}
function decode_(v){if(Object.prototype.toString.call(v)==='[object Date]')return v.toISOString();if(typeof v!=='string')return v;if(v==='true')return true;if(v==='false')return false;if(/^\s*[\[{]/.test(v)){try{return JSON.parse(v);}catch(e){}}return v;}
function out_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}
